{
	"info": {
		"name": "GitHub Analytics",
		"description": "Requisições da API do projeto GitHub Analytics (backend Java + Spring Boot + API do GitHub). Importe no Postman, Insomnia ou Bruno. Altere as variáveis base_url, usuario e repositorio conforme necessário.",
